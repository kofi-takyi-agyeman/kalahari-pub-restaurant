# ==============================================================================
# Environment Configuration Template — Kalahari Pub & Restaurant
# Developer: Data_Nova
# ==============================================================================
# Copy this file to .env.local and fill in the values from your Supabase Dashboard:
# Supabase Dashboard -> Project Settings -> API
#
# DO NOT COMMIT .env.local TO VERSION CONTROL.
# ==============================================================================

# Public Supabase API URL (Browser & Server)
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anonymous Key (Browser & Server)
# Safe to expose in the browser; restricted by Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Privileged Supabase Service Role Key (SERVER-ONLY)
# NEVER EXPOSE THIS KEY IN BROWSER CODE OR PUBLIC VARIABLES.
# Bypasses Row Level Security for admin/seed operations only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Application Base URL (for OpenGraph / canonical metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
