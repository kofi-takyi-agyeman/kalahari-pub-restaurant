# ==============================================================================
# Environment Configuration Template — Kalahari Pub & Restaurant
# Developed by Data_Nova
# ==============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# DO NOT COMMIT .env.local TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CORE CONFIGURATION (Required for live DB)
# ------------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Privileged Supabase Service Role Key (SERVER-ONLY)
# NEVER EXPOSE THIS KEY IN CLIENT BUNDLES.
# Used exclusively for admin provisioning and server-side privileged tasks.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. APPLICATION & DEPLOYMENT URL
# ------------------------------------------------------------------------------
# Canonical URL used for OpenGraph, structured data, and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE (Menu dish photos)
# ------------------------------------------------------------------------------
# Public bucket name created via migration 20261015000002_create_admin_and_settings_schema.sql
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=menu-images

# ------------------------------------------------------------------------------
# 4. OPTIONAL: GHANAIAN SMS & NOTIFICATION GATEWAY (Future Integration)
# ------------------------------------------------------------------------------
# When approved by the restaurant owner, configure an SMS provider (e.g., Arkesel, Hubtel).
# If unconfigured, the system runs safely without external SMS dispatch.
NOTIFICATION_PROVIDER=none
NOTIFICATION_API_KEY=
NOTIFICATION_SENDER_ID=KALAHARI

# ------------------------------------------------------------------------------
# 5. OPTIONAL: PAYMENT PROVIDER GATEWAY (Future Integration)
# ------------------------------------------------------------------------------
# When approved by the restaurant owner, configure Paystack or Hubtel for Mobile Money / Card.
# If unconfigured, online payment is disabled and only approved Pay-at-Pickup is supported.
PAYMENT_PROVIDER=none
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
